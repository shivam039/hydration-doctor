{
  "name": "hydration-doctor",
  "version": "0.27.0",
  "description": "Experimental pre-1.0 CLI for checking SSR/CSR and navigation inconsistencies; APIs may change.",
  "type": "module",
  "bin": {
    "hydration-doctor": "./src/cli/index.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./config": "./src/config/index.js"
  },
  "engines": {
    "node": ">=20.11"
  },
  "files": [
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/shivam039/hydration-doctor.git"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test",
    "test:consumer": "node scripts/consumer-smoke.js",
    "test:browser-smoke": "node scripts/browser-engine-smoke.js",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "check": "npm run lint && npm test && npm run format:check"
  },
  "dependencies": {
    "@typescript-eslint/typescript-estree": "^8.70.1",
    "espree": "^10.4.0",
    "minimatch": "^9.0.9",
    "playwright": "^1.55.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "eslint": "^9.35.0",
    "next": "^15.5.26",
    "prettier": "^3.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.28"
    }
  }
}
